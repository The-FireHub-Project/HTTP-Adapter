{
  "name": "the-firehub-project/http-adapter",
  "description": "HTTP request handling and application integration runtime for The FireHub Project.",
  "type": "library",
  "keywords": ["php", "framework", "http", "firehub", "request-handling", "request-response"],
  "homepage": "https://the-firehub-project.github.io/http-adapter",
  "license": "Apache-2.0",
  "require": {
    "php": "^8.5",

    "the-firehub-project/core-standard": "dev-develop",
    "the-firehub-project/runtime": ">=0.1.0 <1.0.0",
    "the-firehub-project/application": "dev-develop"
  },
  "require-dev": {
    "phpstan/phpstan": "^2.0",
    "the-firehub-project/phpstan-rules": "dev-develop",

    "the-firehub-project/testing": "dev-develop"
  },
  "minimum-stability": "stable",
  "autoload": {
    "psr-4": {
      "FireHub\\Adapter\\HTTP\\": "src"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "FireHub\\Tests\\Adapter\\HTTP\\": "tests/"
    }
  },
  "authors": [
    {
      "name": "Danijel Galić",
      "email": "danijel.galic@outlook.com",
      "homepage": "https://github.com/dieselxxx",
      "role": "Owner"
    }
  ],
  "support": {
    "email": "danijel.galic@outlook.com",
    "issues": "https://github.com/The-FireHub-Project/HTTP-Adapter/issues",
    "forum": "https://github.com/orgs/The-FireHub-Project/discussions",
    "wiki": "https://github.com/The-FireHub-Project/HTTP-Adapter/wiki",
    "source": "https://github.com/The-FireHub-Project/HTTP-Adapter",
    "docs": "https://the-firehub-project.github.io/HTTP-Adapter",
    "security": "https://github.com/The-FireHub-Project/HTTP-Adapter/security/policy"
  },
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/The-FireHub-Project"
    }
  ],
  "config": {
    "prepend-autoloader": false,
    "optimize-autoloader": true,
    "platform-check": true
  },
  "extra": {
    "firehub": {
      "layer": "adapter",
      "edition": "standard",
      "role": "integration",
      "criticality": "high"
    }
  }
}